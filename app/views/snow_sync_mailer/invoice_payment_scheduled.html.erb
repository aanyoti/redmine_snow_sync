<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body     { font-family: Arial, sans-serif; font-size: 14px; color: #333; margin: 0; padding: 0; }
    .wrapper { max-width: 600px; margin: 0 auto; padding: 24px; }
    .header  { background: #273c88; color: #fff; padding: 16px 20px; border-radius: 4px 4px 0 0; }
    .header h2 { margin: 0; font-size: 18px; }
    .body    { border: 1px solid #ddd; border-top: none; padding: 24px; border-radius: 0 0 4px 4px; }
    .facts   { width: 100%; border-collapse: collapse; margin: 16px 0; }
    .facts td { padding: 8px 12px; border-bottom: 1px solid #f0f0f0; font-size: 13px; }
    .facts td:first-child { font-weight: bold; color: #555; width: 160px; }
    .note    { background: #f0f4ff; border-left: 4px solid #273c88; padding: 12px 16px;
               margin: 16px 0; font-size: 13px; line-height: 1.6; }
    .btn     { display: inline-block; margin-top: 16px; padding: 10px 20px;
               background: #273c88; color: #fff; text-decoration: none;
               border-radius: 4px; font-size: 13px; }
    .footer  { font-size: 11px; color: #999; margin-top: 20px; border-top: 1px solid #eee; padding-top: 10px; }
  </style>
</head>
<body>
<div class="wrapper">

  <div class="header">
    <h2>&#9989; Payment Scheduled</h2>
  </div>

  <div class="body">
    <p>Dear <%= @author_name %>,</p>

    <p>
      Your invoice submission has been reviewed and approved by our Finance team.
      A payment has been <strong>scheduled</strong> for processing.
    </p>

    <table class="facts">
      <tr><td>Invoice Reference</td><td><%= @issue.subject %></td></tr>
      <tr><td>PO Number</td><td><strong><%= @po_number %></strong></td></tr>
      <tr><td>Invoice Amount</td><td><strong><%= @invoice_amount %></strong></td></tr>
      <tr><td>Invoice Date</td><td><%= @invoice_date %></td></tr>
      <tr><td>Submission Type</td><td><%= @submission_type %></td></tr>
      <tr><td>Redmine Reference</td><td>#<%= @issue.id %></td></tr>
    </table>

    <div class="note">
      If you have any questions regarding this payment, please contact the Liquid IT Finance team
      and quote PO Number <strong><%= @po_number %></strong> in all correspondence.
    </div>

    <a href="<%= @issue_url %>" class="btn">View Invoice Submission</a>
  </div>

  <div class="footer">
    Liquid IT Zambia &mdash; This is an automated notification. Please do not reply to this email.
  </div>

</div>
</body>
</html>
