<!-- ═══ SNOW PIPELINE ═══ -->
<div class="page" id="page-snow-pipeline">
  <div class="section-title">SNow — Live Request Pipeline</div>
  <div id="snowPipelineLoading" style="text-align:center;padding:40px;color:#64748b;font-size:14px;">Loading…</div>
  <div id="snowPipelineContent" style="display:none">
    <div style="margin-bottom:8px;display:flex;gap:8px;align-items:center">
      <input id="snowSearch" type="text" placeholder="Search number, description, account…"
        oninput="filterSnowPipeline()"
        style="flex:1;max-width:360px;padding:5px 10px;border:1px solid #dde3f0;border-radius:6px;font-size:12px">
      <span id="snowPipelineCount" style="font-size:11px;color:#64748b"></span>
    </div>
    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;font-size:12px">
        <thead><tr style="background:var(--light)">
          <th style="padding:6px 8px;text-align:left;font-weight:600;white-space:nowrap">Number</th>
          <th style="padding:6px 8px;text-align:left;font-weight:600">Description</th>
          <th style="padding:6px 8px;text-align:left;font-weight:600;white-space:nowrap">Stage</th>
          <th style="padding:6px 8px;text-align:left;font-weight:600;white-space:nowrap">State</th>
          <th style="padding:6px 8px;text-align:left;font-weight:600">Account</th>
          <th style="padding:6px 8px;text-align:left;font-weight:600;white-space:nowrap">Group</th>
          <th style="padding:6px 8px;text-align:left;font-weight:600;white-space:nowrap">Opened</th>
          <th style="padding:6px 8px;text-align:left;font-weight:600;white-space:nowrap">Due</th>
        </tr></thead>
        <tbody id="snowPipelineBody"></tbody>
      </table>
    </div>
