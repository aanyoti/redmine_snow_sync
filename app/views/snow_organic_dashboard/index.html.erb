// ═══ SNOW LIVE ═══════════════════════════════════════════
let SNOW = null;
let SNOW_LOADED = false;

const SNOW_STATE_COLORS = {
  'Open':'#f59e0b','Work in Progress':'#1e40af','Closed Complete':'#16a34a',
  'Closed Incomplete':'#dc2626','Closed Skipped':'#94a3b8'
};
const SNOW_STAGE_COLORS = ['#1e40af','#3b82f6','#0891b2','#0d9488','#16a34a','#84cc16','#f59e0b','#ef4444','#8b5cf6','#ec4899'];

function snowHideLoaders(){
  ['snowLoadingMsg','snowStageLoading','snowPipelineLoading'].forEach(id=>{
    const el=document.getElementById(id); if(el) el.style.display='none';
  });
  ['snowContent','snowStageContent','snowPipelineContent'].forEach(id=>{
    const el=document.getElementById(id); if(el) el.style.display='';
  });
}

async function fetchSnowData(){
  document.getElementById('snowSpinner').style.display='inline-block';
  document.getElementById('snowHint').textContent='Loading from ServiceNow…';
  const params=new URLSearchParams();
  getMulti('fSnowState').forEach(v=>params.append('state[]',v));
  getMulti('fSnowStage').forEach(v=>params.append('stage[]',v));
  getMulti('fSnowGroup').forEach(v=>params.append('snow_group[]',v));
  try {
    const res=await fetch(`/snow_organic_dashboard/snow_live?${params}`,{headers:{'X-Requested-With':'XMLHttpRequest'}});
    if(!res.ok) throw new Error('SNow request failed: '+res.status);
    SNOW=await res.json();
    SNOW_LOADED=true;
    renderSnow();
    const anyFilter=params.toString().length>0;
    document.getElementById('snowHint').textContent=anyFilter
      ? `Filtered · ${n2s(SNOW.kpi.total)} requests · Live ${SNOW.generated_at}`
      : `Live · ${n2s(SNOW.kpi.total)} requests (Mar 2026+) · ${SNOW.generated_at}`;
  } catch(e){
    document.getElementById('snowHint').textContent='Error loading SNow data — retry?';
    console.error(e);
  } finally {
    document.getElementById('snowSpinner').style.display='none';
  }
}

function clearSnowFilters(){
  ['fSnowState','fSnowStage','fSnowGroup'].forEach(id=>{
    document.querySelectorAll('#'+id+' input[type=checkbox]').forEach(c=>c.checked=false);
    msUpdateBtn(id);
  });
  SNOW_LOADED=false;
  fetchSnowData();
}

function renderSnow(){
  if(!SNOW) return;
  snowHideLoaders();

  // KPI cards
  document.getElementById('snTotal').textContent    = n2s(SNOW.kpi.total);
  document.getElementById('snOpen').textContent     = n2s(SNOW.kpi.open);
  document.getElementById('snWip').textContent      = n2s(SNOW.kpi.wip);
  document.getElementById('snComplete').textContent = n2s(SNOW.kpi.complete);
  document.getElementById('snOverdue').textContent  = n2s(SNOW.kpi.overdue);

  // State donut
  const stateLabels = SNOW.by_state.map(s=>s.state);
  const stateCounts = SNOW.by_state.map(s=>s.cnt);
  const stateColors = stateLabels.map(l=>SNOW_STATE_COLORS[l]||'#94a3b8');
  if(CHARTS['cSnowState']){ CHARTS['cSnowState'].destroy(); delete CHARTS['cSnowState']; }
  mkc('cSnowState','doughnut',stateLabels,
    [{data:stateCounts,backgroundColor:stateColors,borderWidth:2,borderColor:'#fff'}],
    {plugins:{legend:{position:'right',labels:{font:{size:10},boxWidth:12}}}});

  // Monthly bar
  if(CHARTS['cSnowMonthly']){ CHARTS['cSnowMonthly'].destroy(); delete CHARTS['cSnowMonthly']; }
  mkc('cSnowMonthly','bar',SNOW.monthly.map(m=>m.m),
    [{label:'Requests',data:SNOW.monthly.map(m=>m.cnt),backgroundColor:'#1e40af',borderRadius:4}],
    {plugins:{legend:{display:false}},scales:{x:{ticks:{font:{size:9}}},y:{ticks:{font:{size:9}}}}});

  // Sort stages by pipeline order
  const STAGE_ORDER = ['New','Awaiting site survey','Awaiting approval','Awaiting acceptance','Installation','Configuration','Testing','Complete'];
  const sortedStages = [...SNOW.by_stage].sort((a,b)=>{
    const ai=STAGE_ORDER.indexOf(a.stage), bi=STAGE_ORDER.indexOf(b.stage);
    return (ai<0?99:ai)-(bi<0?99:bi);
  });

  // Stage summary bar (overview page) — pipeline order
  if(CHARTS['cSnowStageSummary']){ CHARTS['cSnowStageSummary'].destroy(); delete CHARTS['cSnowStageSummary']; }
  mkc('cSnowStageSummary','bar',sortedStages.map(s=>s.stage),
    [{label:'Requests',data:sortedStages.map(s=>s.cnt),
      backgroundColor:SNOW_STAGE_COLORS,borderRadius:4}],
    {plugins:{legend:{display:false}},indexAxis:'y',
     scales:{x:{ticks:{font:{size:9}}},y:{ticks:{font:{size:9}}}}});

  // Stage detail page
  if(CHARTS['cSnowStageBar']){ CHARTS['cSnowStageBar'].destroy(); delete CHARTS['cSnowStageBar']; }
  mkc('cSnowStageBar','bar',sortedStages.map(s=>s.stage),
    [{label:'Requests',data:sortedStages.map(s=>s.cnt),
      backgroundColor:SNOW_STAGE_COLORS.concat(SNOW_STAGE_COLORS),borderRadius:4}],
    {plugins:{legend:{display:false}},indexAxis:'y',
     scales:{x:{ticks:{font:{size:9}}},y:{ticks:{font:{size:9},maxRotation:0}}}});

  const stageTotal=sortedStages.reduce((a,s)=>a+s.cnt,0)||1;
  document.getElementById('snowStageTableBody').innerHTML=sortedStages.map((s,i)=>`
    <tr style="border-top:1px solid var(--border)">
      <td style="padding:5px 10px">${s.stage||'—'}</td>
      <td style="padding:5px 10px;text-align:right;font-weight:600">${n2s(s.cnt)}</td>
      <td style="padding:5px 10px;text-align:right;color:#64748b">${(s.cnt/stageTotal*100).toFixed(1)}%</td>
      <td style="padding:5px 10px;min-width:120px">
        <div style="height:8px;background:#e2e8f0;border-radius:4px;overflow:hidden">
          <div style="height:100%;width:${Math.min(100,(s.cnt/stageTotal*100)).toFixed(1)}%;background:${SNOW_STAGE_COLORS[i%SNOW_STAGE_COLORS.length]};border-radius:4px"></div>
        </div>
      </td>
    </tr>`).join('');

  // Pipeline
  renderSnowPipeline(SNOW.requests);
  document.getElementById('snowSearch').value='';
}

let SNOW_ALL_REQUESTS = [];
function renderSnowPipeline(rows){
  SNOW_ALL_REQUESTS=rows||[];
  filterSnowPipeline();
}

function filterSnowPipeline(){
  const q=(document.getElementById('snowSearch').value||'').toLowerCase();
  const filtered=q ? SNOW_ALL_REQUESTS.filter(r=>
    (r.num||'').toLowerCase().includes(q)||
    (r.desc||'').toLowerCase().includes(q)||
    (r.acct||'').toLowerCase().includes(q)||
    (r.stage||'').toLowerCase().includes(q)
  ) : SNOW_ALL_REQUESTS;
  document.getElementById('snowPipelineCount').textContent=`${n2s(filtered.length)} requests`;
  const STATE_BADGE={
    'Open':'background:#fef3c7;color:#92400e',
    'Work in Progress':'background:#dbeafe;color:#1e3a8a',
    'Closed Complete':'background:#dcfce7;color:#14532d',
    'Closed Incomplete':'background:#fee2e2;color:#7f1d1d'
  };
  document.getElementById('snowPipelineBody').innerHTML=filtered.map(r=>{
    const st=r.state||'';
    const badge=STATE_BADGE[st]||'background:#f1f5f9;color:#475569';
    const due=r.due?r.due.substring(0,10):'—';
    const opened=r.opened?r.opened.substring(0,10):'—';
    const isOverdue=r.due&&r.due<new Date().toISOString()&&(st==='Open'||st==='Work in Progress');
    return `<tr style="border-top:1px solid var(--border)${isOverdue?';background:#fff5f5':''}">
      <td style="padding:5px 8px;font-family:monospace;font-size:11px;white-space:nowrap">
        <a href="https://oneliquidsupport.service-now.com/nav_to.do?uri=sc_request.do?sys_id=${r.sys_id}" target="_blank" style="color:#1e40af;text-decoration:none">${r.num||'—'} ↗</a>
      </td>
      <td style="padding:5px 8px;max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${r.desc||''}">${r.desc||'—'}</td>
      <td style="padding:5px 8px;white-space:nowrap;font-size:11px">${r.stage||'—'}</td>
      <td style="padding:5px 8px;white-space:nowrap">
        <span style="padding:2px 7px;border-radius:10px;font-size:10px;font-weight:600;${badge}">${st||'—'}</span>
      </td>
      <td style="padding:5px 8px;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${r.acct||''}">${r.acct||'—'}</td>
      <td style="padding:5px 8px;white-space:nowrap;font-size:11px">${(r.group||'').replace('Zambia ','ZM ')}</td>
      <td style="padding:5px 8px;white-space:nowrap;font-size:11px">${opened}</td>
      <td style="padding:5px 8px;white-space:nowrap;font-size:11px;${isOverdue?'color:#dc2626;font-weight:700':''}">${due}</td>
    </tr>`;
  }).join('');
}

const SNOW_URL = 'https://oneliquidsupport.service-now.com';

function snowReqTable(rows){
  const now = new Date();
  const STATE_BADGE = {
    'Open':'background:#fef3c7;color:#92400e',
    'Work in Progress':'background:#dbeafe;color:#1e3a8a',
    'Closed Complete':'background:#dcfce7;color:#14532d',
    'Closed Incomplete':'background:#fee2e2;color:#7f1d1d'
  };
  return `<div class="tbl"><table><thead><tr>
    <th>Number</th><th>Description</th><th>Stage</th><th>State</th>
    <th>Account</th><th>Group</th><th>Opened</th><th>Due</th><th>Days Open</th>
  </tr></thead><tbody>${rows.map(r=>{
    const st=r.state||'';
    const badge=STATE_BADGE[st]||'background:#f1f5f9;color:#475569';
    const openedDate=r.opened?r.opened.substring(0,10):'—';
    const dueDate=r.due?r.due.substring(0,10):'—';
    const daysOpen=r.opened ? Math.floor((now - new Date(r.opened.replace(/\//g,'-')))/(1000*60*60*24)) : '—';
    const isOverdue=r.due&&r.due<now.toISOString()&&(st==='Open'||st==='Work in Progress');
    const rowStyle=isOverdue?'background:#fff5f5':'';
    const snowLink=r.sys_id?`${SNOW_URL}/nav_to.do?uri=sc_request.do?sys_id=${r.sys_id}`:'#';
    return `<tr style="${rowStyle}">
      <td><a href="${snowLink}" target="_blank" style="color:#1e40af;text-decoration:none;font-family:monospace;font-size:11px">${r.num||'—'} ↗</a></td>
      <td title="${r.desc||''}">${(r.desc||'—').substring(0,40)}${(r.desc||'').length>40?'…':''}</td>
      <td style="white-space:nowrap;font-size:11px">${r.stage||'—'}</td>
      <td><span style="padding:2px 7px;border-radius:10px;font-size:10px;font-weight:600;${badge}">${st||'—'}</span></td>
      <td title="${r.acct||''}">${(r.acct||'—').substring(0,20)}${(r.acct||'').length>20?'…':''}</td>
      <td style="font-size:11px;white-space:nowrap">${(r.group||'').replace('Zambia ','ZM ')}</td>
      <td style="font-size:11px;white-space:nowrap">${openedDate}</td>
      <td style="font-size:11px;white-space:nowrap;${isOverdue?'color:#dc2626;font-weight:700':''}">${dueDate}</td>
      <td style="text-align:right;${daysOpen>30&&(st==='Open'||st==='Work in Progress')?'color:#dc2626;font-weight:700':''}">${typeof daysOpen==='number'?daysOpen+'d':daysOpen}</td>
    </tr>`;
  }).join('')}</tbody></table></div>`;
}

function showSnowDT(type){
  if(!SNOW) return;
  const title=document.getElementById('dtTitle'), body=document.getElementById('dtBody');
  const k=SNOW.kpi;
  const now=new Date();
  let rows, label, kpiHtml;
  if(type==='all'){
    rows=SNOW.requests;
    label=`All SNow Requests — Mar 2026+ (${n2s(k.total)})`;
    kpiHtml=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(k.total)}</div><div class="dt-kpi-lbl">Total</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(k.open)}</div><div class="dt-kpi-lbl">Open</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(k.wip)}</div><div class="dt-kpi-lbl">WIP</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(k.complete)}</div><div class="dt-kpi-lbl">Complete</div></div>
    </div>`;
  } else if(type==='open'){
    rows=SNOW.requests.filter(r=>r.state==='Open');
    label=`Open SNow Requests (${n2s(rows.length)})`;
    kpiHtml=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(rows.length)}</div><div class="dt-kpi-lbl">Open</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(rows.filter(r=>!r.due||r.due>now.toISOString()).length)}</div><div class="dt-kpi-lbl">On Time</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(rows.filter(r=>r.due&&r.due<now.toISOString()).length)}</div><div class="dt-kpi-lbl">Overdue</div></div>
    </div>`;
  } else if(type==='wip'){
    rows=SNOW.requests.filter(r=>r.state==='Work in Progress');
    label=`Work in Progress (${n2s(rows.length)})`;
    kpiHtml=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(rows.length)}</div><div class="dt-kpi-lbl">WIP</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${rows.length>0?Math.round(rows.reduce((s,r)=>{const d=r.opened?Math.floor((now-new Date(r.opened.replace(/\//g,'-')))/(86400000)):0;return s+d;},0)/rows.length):0}d</div><div class="dt-kpi-lbl">Avg Age</div></div>
    </div>`;
  } else if(type==='complete'){
    rows=SNOW.requests.filter(r=>r.state==='Closed Complete');
    label=`Closed Complete (${n2s(rows.length)})`;
    kpiHtml=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(rows.length)}</div><div class="dt-kpi-lbl">Delivered</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(SNOW.kpi.total>0?Math.round(rows.length/SNOW.kpi.total*100):0)}%</div><div class="dt-kpi-lbl">of Total</div></div>
    </div>`;
  } else if(type==='overdue'){
    rows=SNOW.requests.filter(r=>r.due&&r.due<now.toISOString()&&(r.state==='Open'||r.state==='Work in Progress'));
    label=`Overdue Requests (${n2s(rows.length)})`;
    kpiHtml=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(rows.length)}</div><div class="dt-kpi-lbl">Overdue</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${rows.length>0?Math.round(rows.reduce((s,r)=>{const d=r.due?Math.floor((now-new Date(r.due.replace(/\//g,'-')))/(86400000)):0;return s+d;},0)/rows.length):0}d</div><div class="dt-kpi-lbl">Avg Days Late</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(SNOW.kpi.total>0?Math.round(rows.length/SNOW.kpi.total*100):0)}%</div><div class="dt-kpi-lbl">of Total</div></div>
    </div>`;
  }
  title.textContent=label;
  body.innerHTML=(kpiHtml||'')+snowReqTable(rows||[]);
  document.getElementById('dtOverlay').classList.add('open');
}

// Wire up SNow ms dropdowns to refetch
function initSnowFilters(){
  ['fSnowState','fSnowStage','fSnowGroup'].forEach(id=>{
    const wrap=document.getElementById(id); if(!wrap) return;
    wrap.querySelectorAll('input[type=checkbox]').forEach(cb=>{
      cb.addEventListener('change',()=>{ msUpdateBtn(id); if(SNOW_LOADED){ SNOW_LOADED=false; fetchSnowData(); } });
    });
