<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LITZM Service Delivery</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root{
  --navy:#1a3a6b; --blue:#273c88; --mid:#3a5cbf; --light:#e8edf8;
  --green:#16a34a; --amber:#d97706; --red:#dc2626; --purple:#7c3aed; --teal:#0891b2;
  --bg:#f0f2f8; --card:#ffffff; --text:#1e293b; --muted:#64748b; --border:#dde3f0;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:14px;}
.header{background:linear-gradient(135deg,var(--navy) 0%,var(--blue) 60%,var(--mid) 100%);color:#fff;
  padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:52px;
  position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,.3);}
.logo{font-size:20px;font-weight:800;letter-spacing:-.5px;}
.logo span{color:#60a5fa;}
.header-meta{font-size:11px;opacity:.75;margin-top:1px;}
.header-right{display:flex;align-items:center;gap:14px;font-size:11px;opacity:.85;}
.pill{background:rgba(255,255,255,.15);border-radius:20px;padding:3px 10px;}
.nav-groups{background:#111827;display:flex;padding:0 24px;gap:2px;}
.nav-group-btn{padding:8px 18px;font-size:11px;font-weight:700;cursor:pointer;
  color:rgba(255,255,255,.5);border:none;border-bottom:3px solid transparent;
  text-transform:uppercase;letter-spacing:.8px;background:none;transition:all .2s;}
.nav-group-btn:hover{color:#fff;}
.nav-group-btn.active{color:#60a5fa;border-bottom-color:#60a5fa;}
.nav-group-sep{width:1px;background:rgba(255,255,255,.1);margin:6px 4px;}
.nav-tabs{background:var(--navy);display:flex;padding:0 24px;gap:1px;border-bottom:1px solid rgba(255,255,255,.08);}
.nav-tab{padding:8px 16px;font-size:11px;font-weight:600;cursor:pointer;display:none;
  color:rgba(255,255,255,.55);border:none;border-bottom:3px solid transparent;
  text-transform:uppercase;letter-spacing:.4px;background:none;transition:all .2s;}
.nav-tab.group-visible{display:block;}
.nav-tab:hover{color:#fff;}
.nav-tab.active{color:#93c5fd;border-bottom-color:#93c5fd;}
.filter-bar{background:var(--card);border-bottom:1px solid var(--border);
  padding:8px 24px;display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
.fl{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;}
.filter-bar select,.filter-bar input[type=date]{border:1px solid var(--border);border-radius:6px;padding:5px 9px;
  font-size:11px;color:var(--text);background:#fff;cursor:pointer;outline:none;}
.filter-bar select:focus,.filter-bar input[type=date]:focus{border-color:var(--mid);}
.fsep{height:18px;width:1px;background:var(--border);}
.fbtn{padding:5px 12px;border-radius:6px;border:1px solid var(--mid);
  color:var(--mid);font-size:11px;font-weight:600;cursor:pointer;background:none;}
.fbtn:hover{background:var(--mid);color:#fff;}
.fhint{font-size:10px;color:var(--muted);margin-left:auto;}
.page{display:none;padding:20px 24px;max-width:1600px;}
.page.active{display:block;}
.section-title{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;
  letter-spacing:1px;margin-bottom:10px;display:flex;align-items:center;gap:8px;}
.section-title::after{content:'';flex:1;height:1px;background:var(--border);}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(165px,1fr));gap:12px;margin-bottom:20px;}
.kpi{background:var(--card);border-radius:10px;padding:16px 18px;border-left:4px solid var(--mid);
  box-shadow:0 1px 3px rgba(0,0,0,.06);cursor:pointer;transition:transform .15s,box-shadow .15s;}
.kpi:hover{transform:translateY(-2px);box-shadow:0 6px 14px rgba(0,0,0,.10);}
.kpi.green{border-left-color:var(--green);}.kpi.amber{border-left-color:var(--amber);}
.kpi.red{border-left-color:var(--red);}.kpi.purple{border-left-color:var(--purple);}.kpi.teal{border-left-color:var(--teal);}
.kpi-label{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px;}
.kpi-value{font-size:26px;font-weight:800;color:var(--navy);line-height:1;}
.kpi-value.green{color:var(--green);}.kpi-value.amber{color:var(--amber);}
.kpi-value.red{color:var(--red);}.kpi-value.purple{color:var(--purple);}.kpi-value.teal{color:var(--teal);}
.kpi-sub{font-size:10px;color:var(--muted);margin-top:5px;}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px;}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:16px;}
.g32{display:grid;grid-template-columns:3fr 2fr;gap:14px;margin-bottom:16px;}
.g23{display:grid;grid-template-columns:2fr 3fr;gap:14px;margin-bottom:16px;}
.chart-card{background:var(--card);border-radius:10px;padding:16px 18px;
  box-shadow:0 1px 3px rgba(0,0,0,.06);border:1px solid var(--border);}
.chart-card.accent{border-top:3px solid var(--mid);}
.chart-card.accent-green{border-top:3px solid var(--green);}
.chart-card.accent-red{border-top:3px solid var(--red);}
.chart-card.accent-amber{border-top:3px solid var(--amber);}
.ch{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px;}
.ct{font-size:13px;font-weight:700;color:var(--navy);}
.cd{font-size:10px;color:var(--muted);margin-top:2px;}
.cbadge{font-size:9px;font-weight:700;padding:2px 7px;border-radius:10px;background:var(--light);color:var(--blue);}
.cw{position:relative;}
.badge{display:inline-block;padding:2px 7px;border-radius:10px;font-size:10px;font-weight:700;white-space:nowrap;}
.bb{background:#dbeafe;color:#1d4ed8;}.bg{background:#dcfce7;color:#15803d;}
.ba{background:#fef3c7;color:#b45309;}.br{background:#fee2e2;color:#b91c1c;}
.bp{background:#ede9fe;color:#6d28d9;}.bt{background:#cffafe;color:#0e7490;}
.bk{background:#f1f5f9;color:#475569;}
.tbl{overflow-x:auto;border-radius:8px;border:1px solid var(--border);}
table{width:100%;border-collapse:collapse;font-size:11px;}
thead th{background:var(--navy);color:#fff;padding:8px 10px;text-align:left;
  font-weight:600;font-size:10px;letter-spacing:.3px;white-space:nowrap;}
tbody tr{border-bottom:1px solid var(--border);cursor:pointer;}
tbody tr:hover{background:var(--light);}
tbody td{padding:7px 10px;}
tbody tr:last-child{border-bottom:none;}
.prow{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.plabel{font-size:11px;min-width:170px;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.pbar{flex:1;height:7px;background:var(--light);border-radius:4px;overflow:hidden;}
.pfill{height:100%;background:var(--mid);border-radius:4px;}
.pfill.green{background:var(--green);}.pfill.red{background:var(--red);}
.pval{font-size:10px;color:var(--muted);min-width:55px;text-align:right;font-weight:600;}
.sla-bar{display:flex;height:22px;border-radius:6px;overflow:hidden;}
.sla-ok{background:var(--green);display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:10px;font-weight:700;}
.sla-breach{background:var(--red);display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:10px;font-weight:700;}
.funnel{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 0;}
.funnel-step{display:flex;width:100%;max-width:600px;align-items:center;gap:10px;}
.funnel-bar-wrap{flex:1;height:34px;background:var(--light);border-radius:4px;overflow:hidden;position:relative;}
.funnel-fill{height:100%;border-radius:4px;display:flex;align-items:center;padding-left:10px;
  color:#fff;font-size:11px;font-weight:700;white-space:nowrap;overflow:hidden;}
.funnel-label{min-width:200px;font-size:11px;font-weight:600;text-align:right;}
.funnel-val{min-width:70px;font-size:13px;font-weight:800;color:var(--navy);}
.funnel-pct{min-width:40px;font-size:10px;color:var(--muted);}
.tip{background:linear-gradient(135deg,#eff6ff,#e0ecff);border:1px solid #bfdbfe;
  border-left:4px solid #3b82f6;border-radius:8px;padding:10px 14px;margin-bottom:14px;
  display:flex;gap:10px;align-items:flex-start;}
.tip-icon{font-size:16px;flex-shrink:0;}
.tip-title{font-size:11px;font-weight:700;color:#1e40af;margin-bottom:2px;}
.tip-text{font-size:10px;color:#1d4ed8;line-height:1.5;}
.tip-text code{background:rgba(255,255,255,.7);padding:1px 4px;border-radius:3px;font-size:9px;}
.gap-alert{background:linear-gradient(135deg,#fff7ed,#fef3c7);border:1px solid #fcd34d;
  border-left:4px solid var(--amber);border-radius:8px;padding:12px 16px;margin-bottom:16px;
  display:flex;gap:12px;align-items:flex-start;}
.dt-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);
  z-index:200;align-items:center;justify-content:center;}
.dt-overlay.open{display:flex;}
.dt-panel{background:var(--card);border-radius:12px;width:92vw;max-width:960px;
  max-height:88vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.3);}
.dt-hdr{background:linear-gradient(135deg,var(--navy),var(--blue));color:#fff;
  padding:14px 22px;border-radius:12px 12px 0 0;display:flex;justify-content:space-between;align-items:center;}
.dt-title{font-size:13px;font-weight:700;}
.dt-close{background:rgba(255,255,255,.2);border:none;color:#fff;width:26px;height:26px;
  border-radius:50%;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;}
.dt-body{flex:1;overflow-y:auto;padding:18px 22px;}
.dt-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px;}
.dt-kpi{background:var(--light);border-radius:8px;padding:10px 14px;text-align:center;}
.dt-kpi-val{font-size:18px;font-weight:800;color:var(--navy);}
.dt-kpi-lbl{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-top:2px;}
@media(max-width:900px){.g2,.g3,.g32,.g23{grid-template-columns:1fr;}.dt-kpis{grid-template-columns:repeat(2,1fr);}}
@keyframes spin{to{transform:rotate(360deg);}}
.ms{position:relative;display:inline-block;}
.ms-btn{border:1px solid var(--border);border-radius:6px;padding:5px 9px;font-size:11px;
  color:var(--text);background:#fff;cursor:pointer;white-space:nowrap;outline:none;
  display:flex;align-items:center;gap:5px;}
.ms-btn::after{content:'▾';font-size:9px;color:var(--muted);margin-left:2px;}
.ms-btn:hover{border-color:var(--mid);}
.ms-btn.has-sel{border-color:var(--mid);background:var(--light);color:var(--blue);font-weight:700;}
.ms-panel{display:none;position:absolute;top:calc(100% + 3px);left:0;z-index:500;
  background:#fff;border:1px solid var(--border);border-radius:8px;
  box-shadow:0 6px 20px rgba(0,0,0,.14);min-width:180px;max-height:220px;
  overflow-y:auto;padding:4px 0;}
.ms-panel.open{display:block;}
.ms-item{display:flex;align-items:center;gap:8px;padding:6px 12px;
  cursor:pointer;font-size:11px;white-space:nowrap;color:var(--text);user-select:none;}
.ms-item:hover{background:var(--light);}
.ms-item input[type=checkbox]{cursor:pointer;accent-color:var(--mid);flex-shrink:0;}
</style>
</head>
<body>

<div class="header">
  <div>
    <div class="logo">LITZM <span>Service Delivery</span></div>
    <div class="header-meta">Commercial &amp; Delivery Intelligence — FY27 (Mar 2026 – Feb 2027)</div>
  </div>
  <div class="header-right">
    <div class="pill">Live · <%= @generated_at %></div>
    <div class="pill">FY27 · All figures ZMW unless stated</div>
    <div class="pill"><a href="/admin" style="color:#93c5fd;text-decoration:none;">← Admin</a></div>
  </div>
</div>

<div class="nav-groups">
  <button class="nav-group-btn active" onclick="showGroup('sf',this)">&#9889; Salesforce CRM</button>
  <div class="nav-group-sep"></div>
  <button class="nav-group-btn" onclick="showGroup('bridge',this)">&#128279; SF &#8594; Organic Bridge</button>
  <div class="nav-group-sep"></div>
  <button class="nav-group-btn" onclick="showGroup('organic',this)">&#128230; Organic Delivery</button>
  <div class="nav-group-sep"></div>
  <button class="nav-group-btn" onclick="showGroup('guide',this)">&#128216; PowerBI Guide</button>
  <div class="nav-group-sep"></div>
  <button class="nav-group-btn" onclick="showGroup('snow',this)">&#128225; SNow Live</button>
</div>

<div class="nav-tabs">
  <button class="nav-tab group-visible active" data-group="sf" onclick="showTab('sf-summary',this)">SF Overview</button>
  <button class="nav-tab group-visible" data-group="sf" onclick="showTab('sf-newlogos',this)" style="color:#a78bfa;">&#9733; New Logos</button>
  <button class="nav-tab group-visible" data-group="sf" onclick="showTab('sf-accounts',this)">Accounts</button>
  <button class="nav-tab group-visible" data-group="sf" onclick="showTab('sf-kam',this)">KAM Leaderboard</button>
  <button class="nav-tab" data-group="bridge" onclick="showTab('bridge-funnel',this)">Coverage Funnel</button>
  <button class="nav-tab" data-group="bridge" onclick="showTab('bridge-gap',this)">Delivery Gap Report</button>
  <button class="nav-tab" data-group="organic" onclick="showTab('org-summary',this)">Organic Summary</button>
  <button class="nav-tab" data-group="organic" onclick="showTab('org-pipeline',this)">Pipeline by Stage</button>
  <button class="nav-tab" data-group="organic" onclick="showTab('org-revenue',this)">Revenue &amp; Targets</button>
  <button class="nav-tab" data-group="organic" onclick="showTab('org-sla',this)">SLA Performance</button>
  <button class="nav-tab" data-group="organic" onclick="showTab('org-wip',this)">Active WIP</button>
  <button class="nav-tab" data-group="organic" onclick="showTab('org-sdreport',this)">SD Report</button>
  <button class="nav-tab" data-group="guide" onclick="showTab('pbi-guide',this)">Full Guide</button>
  <button class="nav-tab" data-group="snow" onclick="showTab('snow-overview',this)">Overview</button>
  <button class="nav-tab" data-group="snow" onclick="showTab('snow-stage',this)">By Stage</button>
  <button class="nav-tab" data-group="snow" onclick="showTab('snow-pipeline',this)">Pipeline</button>
</div>

<div class="filter-bar">
  <span class="fl">Filters</span>
  <div class="ms" id="fSegment" data-label="All Segments">
    <button class="ms-btn" type="button">All Segments</button>
    <div class="ms-panel">
      <label class="ms-item"><input type="checkbox" value="Enterprise"> Enterprise</label>
      <label class="ms-item"><input type="checkbox" value="Wholesale"> Wholesale</label>
      <label class="ms-item"><input type="checkbox" value="Retail"> Retail</label>
      <label class="ms-item"><input type="checkbox" value="Internal"> Internal</label>
    </div>
  </div>
  <div class="ms" id="fKam" data-label="All KAMs">
    <button class="ms-btn" type="button">All KAMs</button>
    <div class="ms-panel">
      <% @sf_kams.each do |k| %>
        <label class="ms-item"><input type="checkbox" value="<%= h k['account_owner'] %>"> <%= h k['account_owner'] %></label>
      <% end %>
    </div>
  </div>
  <div class="ms" id="fSfStatus" data-label="All SF Statuses">
    <button class="ms-btn" type="button">All SF Statuses</button>
    <div class="ms-panel">
      <label class="ms-item"><input type="checkbox" value="Accepted by Service Delivery"> Accepted by Service Delivery</label>
      <label class="ms-item"><input type="checkbox" value="Sent for Service Qualification"> Sent for Service Qualification</label>
      <label class="ms-item"><input type="checkbox" value="Service Delivery is not required"> Not Required</label>
      <label class="ms-item"><input type="checkbox" value="Service Delivered"> Service Delivered</label>
      <label class="ms-item"><input type="checkbox" value="Rejected by Service Delivery"> Rejected by Service Delivery</label>
    </div>
  </div>
  <div class="fsep"></div>
  <span class="fl">Organic Tracker</span>
  <div class="ms" id="fTracker" data-label="All Trackers">
    <button class="ms-btn" type="button">All Trackers</button>
    <div class="ms-panel">
      <label class="ms-item"><input type="checkbox" value="14"> Commercial Orders</label>
      <label class="ms-item"><input type="checkbox" value="18"> C2 / Cloud</label>
    </div>
  </div>
  <div class="fsep"></div>
  <button class="fbtn" onclick="clearFilters()">&#10005; Clear</button>
  <span id="filterSpinner" style="display:none;width:14px;height:14px;border:2px solid #dde3f0;border-top-color:#273c88;border-radius:50%;animation:spin .6s linear infinite;flex-shrink:0"></span>
  <span class="fhint" id="filterHint">FY27 · Loading…</span>
</div>

<div id="orgFilterBar" style="display:none;background:#f8f9fe;border-bottom:1px solid #dde3f0;padding:6px 24px;flex-wrap:wrap;align-items:center;gap:8px;font-size:12px;">
  <span class="fl" style="color:#273c88;font-weight:700">&#128230; Organic Filters</span>
  <div class="ms" id="fAssignee" data-label="All Assignees">
    <button class="ms-btn" type="button" style="font-size:12px;padding:3px 8px;min-width:120px">All Assignees</button>
    <div class="ms-panel">
      <% @org_assignees_list.each do |a| %><label class="ms-item"><input type="checkbox" value="<%= h a %>"> <%= h a %></label><% end %>
    </div>
  </div>
  <div class="ms" id="fOrgStatus" data-label="All Statuses">
    <button class="ms-btn" type="button" style="font-size:12px;padding:3px 8px;min-width:130px">All Statuses</button>
    <div class="ms-panel">
      <% @org_statuses_list.each do |s| %><label class="ms-item"><input type="checkbox" value="<%= h s %>"> <%= h s %></label><% end %>
    </div>
  </div>
  <div class="ms" id="fAccount" data-label="All Accounts">
    <button class="ms-btn" type="button" style="font-size:12px;padding:3px 8px;min-width:130px">All Accounts</button>
    <div class="ms-panel">
      <% @org_accounts_list.each do |a| %><label class="ms-item"><input type="checkbox" value="<%= h a %>"> <%= h a %></label><% end %>
    </div>
  </div>
  <div class="ms" id="fOppType" data-label="All Opp Types">
    <button class="ms-btn" type="button" style="font-size:12px;padding:3px 8px;min-width:120px">All Opp Types</button>
    <div class="ms-panel">
      <% @org_opp_types_list.each do |t| %><label class="ms-item"><input type="checkbox" value="<%= h t %>"> <%= h t %></label><% end %>
    </div>
  </div>
  <input id="fOrderNum" type="text" placeholder="Order #" oninput="debouncedFilter()" style="font-size:12px;padding:3px 6px;border:1px solid #dde3f0;border-radius:4px;width:110px">
  <input id="fReqNum" type="text" placeholder="Request #" oninput="debouncedFilter()" style="font-size:12px;padding:3px 6px;border:1px solid #dde3f0;border-radius:4px;width:110px">
  <input id="fAcctNum" type="text" placeholder="Account #" oninput="debouncedFilter()" style="font-size:12px;padding:3px 6px;border:1px solid #dde3f0;border-radius:4px;width:110px">
  <input id="fDateFrom" type="date" onchange="applyFilters()" style="font-size:12px;padding:3px 6px;border:1px solid #dde3f0;border-radius:4px" title="Created from">
  <input id="fDateTo" type="date" onchange="applyFilters()" style="font-size:12px;padding:3px 6px;border:1px solid #dde3f0;border-radius:4px" title="Created to">
  <label style="display:flex;align-items:center;gap:4px;cursor:pointer;font-weight:600;color:#16a34a">
    <input id="fActiveWip" type="checkbox" onchange="applyFilters()"> Active WIP only
  </label>
  <label style="display:flex;align-items:center;gap:4px;cursor:pointer;font-weight:600;color:#dc2626">
    <input id="fOverdue" type="checkbox" onchange="applyFilters()"> Overdue only
  </label>
</div>

<div id="snowFilterBar" style="display:none;background:#f0f4ff;border-bottom:1px solid #c7d2fe;padding:6px 24px;flex-wrap:wrap;align-items:center;gap:8px;font-size:12px;">
  <span class="fl" style="color:#1e40af;font-weight:700">&#128225; SNow Filters</span>
  <div class="ms" id="fSnowState" data-label="All States">
    <button class="ms-btn" type="button" style="font-size:12px;padding:3px 8px;min-width:130px">All States</button>
    <div class="ms-panel">
      <label class="ms-item"><input type="checkbox" value="Open"> Open</label>
      <label class="ms-item"><input type="checkbox" value="Work in Progress"> Work in Progress</label>
      <label class="ms-item"><input type="checkbox" value="Closed Complete"> Closed Complete</label>
      <label class="ms-item"><input type="checkbox" value="Closed Incomplete"> Closed Incomplete</label>
    </div>
  </div>
  <div class="ms" id="fSnowStage" data-label="All Stages">
    <button class="ms-btn" type="button" style="font-size:12px;padding:3px 8px;min-width:130px">All Stages</button>
    <div class="ms-panel">
      <label class="ms-item"><input type="checkbox" value="New"> New</label>
      <label class="ms-item"><input type="checkbox" value="Awaiting site survey"> Awaiting site survey</label>
      <label class="ms-item"><input type="checkbox" value="Awaiting approval"> Awaiting approval</label>
      <label class="ms-item"><input type="checkbox" value="Awaiting acceptance"> Awaiting acceptance</label>
      <label class="ms-item"><input type="checkbox" value="Installation"> Installation</label>
      <label class="ms-item"><input type="checkbox" value="Configuration"> Configuration</label>
      <label class="ms-item"><input type="checkbox" value="Testing"> Testing</label>
      <label class="ms-item"><input type="checkbox" value="Complete"> Complete</label>
    </div>
  </div>
  <div class="ms" id="fSnowGroup" data-label="All Groups">
