function msUpdateBtn(id){
  const wrap=document.getElementById(id); if(!wrap) return;
  const sel=Array.from(wrap.querySelectorAll('input[type=checkbox]:checked'));
  const btn=wrap.querySelector('.ms-btn');
  const def=wrap.dataset.label||'Select';
  btn.textContent = sel.length===0 ? def : (sel.length===1 ? sel[0].parentNode.textContent.trim() : sel.length+' selected');
  btn.classList.toggle('has-sel', sel.length>0);
}
function initAllMs(){
  document.querySelectorAll('.ms').forEach(wrap=>{
    const id=wrap.id, btn=wrap.querySelector('.ms-btn'), panel=wrap.querySelector('.ms-panel');
    btn.addEventListener('click', e=>{
      e.stopPropagation();
      document.querySelectorAll('.ms-panel.open').forEach(p=>{ if(p!==panel) p.classList.remove('open'); });
      panel.classList.toggle('open');
    });
    wrap.querySelectorAll('input[type=checkbox]').forEach(cb=>{
      cb.addEventListener('change',()=>{ msUpdateBtn(id); debouncedFilter(); });
    });
    msUpdateBtn(id);
  });
  document.addEventListener('click',()=>document.querySelectorAll('.ms-panel.open').forEach(p=>p.classList.remove('open')));
}

