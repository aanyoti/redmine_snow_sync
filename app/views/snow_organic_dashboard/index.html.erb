function showDT(type){
  const title=document.getElementById('dtTitle'), body=document.getElementById('dtBody');
  const s=SF.kpi, o=ORGANIC.kpi;
  if(type==='sf-total'){
    title.textContent='SF Pipeline — All Subscriptions (FY27)';
    body.innerHTML=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(s.total)}</div><div class="dt-kpi-lbl">Total Subs</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(s.accounts)}</div><div class="dt-kpi-lbl">Accounts</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(s.mrr_zmw)}</div><div class="dt-kpi-lbl">MRR ZMW</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(s.nrr_zmw)}</div><div class="dt-kpi-lbl">NRR ZMW</div></div>
    </div>${sfStatusTable()}`;
  } else if(type==='sf-mrr'){
    title.textContent='SF Pipeline MRR Breakdown';
    body.innerHTML=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(s.mrr_zmw)}</div><div class="dt-kpi-lbl">Total MRR</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(s.accepted_mrr)}</div><div class="dt-kpi-lbl">Accepted</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(s.qual_mrr)}</div><div class="dt-kpi-lbl">In Qualification</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(s.delivered_mrr)}</div><div class="dt-kpi-lbl">Delivered</div></div>
    </div>${sfStatusTable()}`;
  } else if(type==='open'){
    title.textContent='All Open Organic Orders';
    body.innerHTML=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(o.total)}</div><div class="dt-kpi-lbl">Open Orders</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(o.commercial)}</div><div class="dt-kpi-lbl">Commercial</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(o.c2)}</div><div class="dt-kpi-lbl">C2</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(o.mrr)}</div><div class="dt-kpi-lbl">MRR ZMW</div></div>
    </div>${orgIssueTable(ORGANIC.all_orders)}`;
  } else if(type==='wip'||type==='wip-open'||type==='wip-closed'||type==='wip-comm'||type==='wip-c2'){
    let wipRows = ORGANIC.wip;
    if(type==='wip-open')   wipRows = wipRows.filter(o=>!o.closed);
    if(type==='wip-closed') wipRows = wipRows.filter(o=> o.closed);
    if(type==='wip-comm')   wipRows = wipRows.filter(o=>o.tracker==='Commercial Orders');
    if(type==='wip-c2')     wipRows = wipRows.filter(o=>o.tracker==='C2');
    const openCnt     = ORGANIC.open_wip||0, closedCnt = ORGANIC.closed_wip||0;
    const labelMap    = {'wip':'All Active WIP','wip-open':'Active WIP — Open','wip-closed':'Active WIP — Delivered','wip-comm':'Active WIP — Commercial','wip-c2':'Active WIP — C2'};
    title.textContent = labelMap[type]||'Active WIP Orders';
    body.innerHTML=`<div class="dt-kpis">
      <div class="dt-kpi" onclick="showDT('wip')"       style="cursor:pointer"><div class="dt-kpi-val">${n2s(ORGANIC.wip.length)}</div><div class="dt-kpi-lbl">Total WIP</div></div>
      <div class="dt-kpi" onclick="showDT('wip-open')"  style="cursor:pointer"><div class="dt-kpi-val">${n2s(openCnt)}</div><div class="dt-kpi-lbl">Still Open</div></div>
      <div class="dt-kpi" onclick="showDT('wip-closed')" style="cursor:pointer"><div class="dt-kpi-val" style="color:#0d9488">${n2s(closedCnt)}</div><div class="dt-kpi-lbl">Delivered</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(ORGANIC.wip_mrr)}</div><div class="dt-kpi-lbl">MRR ZMW</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(ORGANIC.wip_nrr||0)}</div><div class="dt-kpi-lbl">NRR ZMW</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${ORGANIC.wip_mrr_usd?'$'+n2s(ORGANIC.wip_mrr_usd):'—'}</div><div class="dt-kpi-lbl">MRR USD</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${ORGANIC.wip_nrr_usd?'$'+n2s(ORGANIC.wip_nrr_usd):'—'}</div><div class="dt-kpi-lbl">NRR USD</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(ORGANIC.comm_wip)}</div><div class="dt-kpi-lbl">Commercial</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(ORGANIC.c2_wip)}</div><div class="dt-kpi-lbl">C2</div></div>
    </div>${orgIssueTable(wipRows)}`;
  } else if(type==='overdue'){
    const ov=ORGANIC.all_orders.filter(o=>o.overdue);
    title.textContent='Overdue Orders ('+ov.length+')';
    const pct=ORGANIC.kpi.total>0?(ov.length/ORGANIC.kpi.total*100).toFixed(1):'0';
    body.innerHTML=`<div class="dt-kpis">
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(ov.length)}</div><div class="dt-kpi-lbl">Overdue</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${n2s(o.overdue)}</div><div class="dt-kpi-lbl">Total Overdue</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${pct}%</div><div class="dt-kpi-lbl">Of Open Orders</div></div>
      <div class="dt-kpi"><div class="dt-kpi-val">${fmtK(ov.reduce((s,r)=>s+r.mrr,0))}</div><div class="dt-kpi-lbl">Overdue MRR</div></div>
    </div>${orgIssueTable(ov)}`;
  }
  document.getElementById('dtOverlay').classList.add('open');
}
