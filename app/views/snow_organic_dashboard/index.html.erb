function sfStatusTable(){
  return `<div class="tbl"><table><thead><tr><th>SF Status</th><th>Count</th><th>MRR (ZMW)</th></tr></thead>
    <tbody>${SF.statuses.map(s=>`<tr><td>${s.s}</td><td>${n2s(s.cnt)}</td><td>${fmt(s.mrr)}</td></tr>`).join('')}</tbody></table></div>`;
