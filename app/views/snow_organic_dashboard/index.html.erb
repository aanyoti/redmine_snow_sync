}

// ═══ SD REPORT ═══════════════════════════════════════════
let SDR_LOADED = false;

function showTab(id, btn) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('page-' + id).classList.add('active');
  if (btn) btn.classList.add('active');
  if (id === 'org-sdreport' && !SDR_LOADED) { loadSDReport(); }
}

async function loadSDReport(force) {
  const sel = document.getElementById('sdrMonth');
  const val = sel ? sel.value : '';
  let year, month;
  if (val) {
    [year, month] = val.split('-').map(Number);
  } else {
    const now = new Date();
    year = now.getFullYear(); month = now.getMonth() + 1;
  }
  const content = document.getElementById('sdrContent');
  content.innerHTML = '<div style="text-align:center;padding:48px;color:var(--muted)">Loading…</div>';
  const badge = document.getElementById('sdrLockBadge');
  badge.style.display = 'none';
  try {
    const res = await fetch(`/snow_organic_dashboard/sd_report?year=${year}&month=${month}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const d = await res.json();
    SDR_LOADED = true;
    renderSDReport(d, content, badge);
  } catch (e) {
    content.innerHTML = `<div style="color:#dc2626;padding:24px">Error loading SD Report: ${e.message}</div>`;
  }
}

function renderSDReport(d, container, badge) {
  badge.textContent = d.target_locked ? '🔒 Target locked ' + d.target_locked_at : '🔓 Target not locked (live Active WIP)';
  badge.style.background = d.target_locked ? '#dcfce7' : '#fef3c7';
  badge.style.color = d.target_locked ? '#14532d' : '#92400e';
  badge.style.display = 'inline-flex';

  const num = n => (n === null || n === undefined) ? '-' : Number(n).toLocaleString('en-US');
  const usd = n => (!n) ? '-' : Number(n).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
  const pct = p => (p === null || p === undefined) ? '-' : Math.round(p) + '%';
  const R = 'text-align:right;font-variant-numeric:tabular-nums';
  const L = 'font-weight:700;color:#1e3a8a';

  const mainTable = (s, isGpon) => {
    const aw = isGpon ? 'Active WIP' : 'Active WIP (AW)';
    const tg = isGpon ? 'SD Target (T)' : 'SD Target (T*)';
    const line = (lbl, k, f) => `<tr>
      <td style="${L}">${lbl}</td>
      <td style="${R}">${f(s.backorder[k])}</td>
      <td style="${R}">${f(s.active_wip[k])}</td>
      <td style="${R}">${f(s.target[k])}</td>
      <td style="${R}">${f(s.added[k])}</td>
      <td style="${R}">${f(s.total_wip[k])}</td>
      <td style="${R}">${f(s.cancelled[k])}</td>
      <td style="${R};color:#16a34a;font-weight:600">${f(s.delivered[k])}</td>
      <td style="${R};font-weight:600">${pct(s.achieved[k])}</td>
      <td style="${R}">-</td></tr>`;
    return `<div class="tbl" style="margin-bottom:4px"><table>
      <thead><tr><th></th><th>Backorder (B)</th><th>${aw}</th><th>${tg}</th><th>Added in ${d.month_short} (A)</th>
        <th>Total WIP (B+A)</th><th>Cancelled</th><th>Delivered (D)</th><th>Achieved (D/T)</th><th>Projected Additional Delivery</th></tr></thead>
      <tbody>${line('SOs','count',num)}${line('MRR (US$)','mrr_usd',usd)}${line('NRR (US$)','nrr_usd',usd)}</tbody>
    </table></div>
    <div style="font-size:11px;font-style:italic;color:var(--muted);margin:0 0 14px 28%">*100% of AW</div>`;
  };

  const holdTable = s => {
    const line = (lbl, k, f) => `<tr><td style="${L}">${lbl}</td>
      <td style="${R}">${f(s.on_hold_cust[k])}</td><td style="${R}">${f(s.on_hold_lit[k])}</td><td style="${R}">${f(s.on_hold_total[k])}</td></tr>`;
    return `<div style="font-weight:700;font-size:12px;color:#1e3a8a;margin:4px 0">SOs On Hold (part of Total WIP)</div>
      <div class="tbl" style="max-width:520px"><table>
      <thead><tr><th></th><th>On Hold - Cust.</th><th>On Hold - LIT</th><th>Total</th></tr></thead>
      <tbody>${line('SOs','count',num)}${line('MRR (US$)','mrr_usd',usd)}${line('NRR (US$)','nrr_usd',usd)}</tbody></table></div>`;
  };

  const section = (s, isGpon) => `
    <div style="margin-bottom:28px">
      <div style="display:inline-block;background:#dbe4f5;color:#1e3a8a;font-weight:700;font-size:12px;padding:3px 10px;margin-bottom:8px">${s.label}</div>
      ${mainTable(s, isGpon)}${holdTable(s)}
    </div>`;

  let cumE = 0, cumG = 0;
  const cum = d.daily.map(r => ({ date: r.date, e: (cumE += r.enterprise), g: (cumG += r.gpon) }));
  const chartHtml = d.daily.length ? `
    <div class="chart-card" style="margin-bottom:20px">
      <div class="ct">Daily Deliveries — ${d.month_label} (Cumulative vs Target)</div>
      <div style="height:200px;position:relative"><canvas id="sdrDailyChart"></canvas></div>
    </div>` : '';

  container.innerHTML = `
    <div style="font-size:12px;color:var(--muted);margin-bottom:14px">
      <strong>${d.month_label}</strong> &middot; as of <strong>${d.today}</strong>
    </div>
    ${section(d.sections.enterprise, false)}
    ${section(d.sections.gpon, true)}
    ${chartHtml}`;

  if (d.daily.length) {
    const ctx = document.getElementById('sdrDailyChart');
    const t = d.sections.enterprise.target.count;
    if (ctx) {
      if (window._sdrChart) window._sdrChart.destroy();
      window._sdrChart = new Chart(ctx, {
        type: 'line',
        data: { labels: cum.map(r => r.date.substring(5)), datasets: [
          { label: 'Enterprise (cumulative D)', data: cum.map(r => r.e), borderColor:'#1a3a6b', backgroundColor:'rgba(26,58,107,0.08)', fill:true, tension:0.3, pointRadius:3 },
          { label: 'GPON (cumulative D)', data: cum.map(r => r.g), borderColor:'#16a34a', fill:false, tension:0.3, pointRadius:3 },
          { label: 'Target (T*)', data: cum.map(() => t), borderColor:'#dc2626', borderDash:[6,3], fill:false, pointRadius:0, borderWidth:1.5 }
        ]},
        options: { responsive:true, maintainAspectRatio:false,
          plugins:{ legend:{ labels:{ font:{size:10}, color:'#1e293b' } } },
          scales:{ x:{ ticks:{font:{size:9},color:'#64748b'} }, y:{ beginAtZero:true, ticks:{font:{size:9},color:'#64748b'} } } }
      });
    }
  }
}

