function buildWipTable(){
  // Show lock badge + meta bar
  const meta = ORGANIC.wip_meta;
  const badge = document.getElementById('wipLockBadge');
  const metaBar = document.getElementById('wipMetaBar');
  if(meta){
    badge.style.display='inline-flex';
    if(meta.locked){
      badge.textContent='🔒 Locked ' + meta.at + (meta.by?' · '+meta.by:'');
      badge.style.background='#dcfce7'; badge.style.color='#14532d';
      metaBar.style.display='block';
      metaBar.innerHTML=`<strong>Locked snapshot</strong> — ${n2s(meta.target_count)} orders at lock time`
        +(meta.uplift_count>0?` · <span style="color:#0891b2;font-weight:600">+${meta.uplift_count} uplift</span> (closed after lock within month)`:'')
        +` · Target MRR: <strong>${fmt(meta.target_mrr)}</strong>`;
    } else {
      badge.textContent='🔓 Not locked — ' + (meta.month_label||'');
      badge.style.background='#fef3c7'; badge.style.color='#92400e';
      metaBar.style.display='block';
      metaBar.style.background='#fffbeb'; metaBar.style.borderColor='#fde68a'; metaBar.style.color='#78350f';
      metaBar.innerHTML=`<strong>${meta.month_label}</strong> has no locked snapshot. `
        +`Lock it on the <a href="/snow_monthly_target" target="_blank" style="color:#b45309;font-weight:600;">Monthly Target page</a> `
        +`to capture a point-in-time view. Select <strong>Live (current)</strong> to see all active WIP now.`;
    }
  } else {
    badge.style.display='none';
    metaBar.style.display='none';
  }

  if(ORGANIC.wip_meta && !ORGANIC.wip_meta.locked && ORGANIC.wip.length===0){
    document.getElementById('wipTable').innerHTML=`<tr><td colspan="14" style="text-align:center;padding:24px;color:#92400e;font-style:italic;">
      No locked snapshot for ${ORGANIC.wip_meta.month_label}. Lock the target first, or select "Live (current)" above.
    </td></tr>`;
    return;
  }

  document.getElementById('wipTable').innerHTML=ORGANIC.wip.map(o=>{
    const rowStyle = o.closed ? 'background:#f0fdfa;opacity:0.85' : (o.uplift ? 'background:#f0f9ff' : '');
    const tags = [
      o.closed  ? '<span class="badge" style="background:#0d9488;color:#fff;font-size:9px">Delivered</span>' : '',
      o.uplift  ? '<span class="badge" style="background:#dbeafe;color:#1e40af;font-size:9px">uplift</span>' : ''
    ].filter(Boolean).join(' ');
    return `<tr onclick="window.open('/issues/${o.id}','_blank')" style="${rowStyle}">
      <td><strong>#${o.id}</strong></td>
      <td><span class="badge bb">${o.tracker||'—'}</span></td>
      <td>${((o.account||'')+'').substring(0,22)}</td>
      <td><code>${o.order||'—'}</code></td>
      <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${o.opp_name||''}">${o.opp_name||'—'}</td>
      <td><span class="badge bg">${(o.status||'').substring(0,22)}</span></td>
      <td>${o.assignee||'—'}</td>
      <td>${fmt(o.mrr)}</td>
      <td style="color:#0891b2">${o.mrr_usd?'$'+n2s(o.mrr_usd):'—'}</td>
