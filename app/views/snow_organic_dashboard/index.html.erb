<!-- DRILLTHROUGH OVERLAY -->
<div class="dt-overlay" id="dtOverlay" onclick="closeDT(event)">
  <div class="dt-panel">
    <div class="dt-hdr">
      <div class="dt-title" id="dtTitle">Detail</div>
      <button class="dt-close" onclick="closeDT(null,true)">&#10005;</button>
    </div>
    <div class="dt-body" id="dtBody"></div>
  </div>
</div>

<script>
// ═══ LIVE DATA FROM CONTROLLER ═══════════════════════════
let SF      = <%= @sf_json.html_safe %>;
let ORGANIC = <%= @organic_json.html_safe %>;
let BRIDGE  = <%= @bridge_json.html_safe %>;
const USD_RATE = <%= @usd_rate %>;

const PAL = ['#1a3a6b','#273c88','#3a5cbf','#60a5fa','#16a34a','#d97706','#dc2626','#7c3aed','#0891b2','#be185d','#065f46','#92400e'];
const fmt  = n => (!n||n===0) ? '—' : 'ZMW '+Number(n).toLocaleString('en-US',{maximumFractionDigits:0});
const fmtK = n => (!n||n===0) ? '—' : (n>=1000000 ? (n/1000000).toFixed(2)+'M' : (n/1000).toFixed(0)+'K');
const fmtU = n => (!n||n===0) ? '' : ' · USD '+Number(n).toLocaleString('en-US',{maximumFractionDigits:0});
const fmtUK= n => (!n||n===0) ? '' : ' · USD '+(n>=1000000?(n/1000000).toFixed(2)+'M':(n/1000).toFixed(0)+'K');
const n2s  = n => Number(n).toLocaleString('en-US',{maximumFractionDigits:0});

// ═══ NAVIGATION ══════════════════════════════════════════
function showGroup(group, btn){
  document.querySelectorAll('.nav-group-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.nav-tab').forEach(t=>{
    t.classList.remove('group-visible','active');
    if(t.dataset.group===group) t.classList.add('group-visible');
  });
  const first=document.querySelector(`.nav-tab[data-group="${group}"]`);
  if(first){ first.classList.add('active'); showTab(first.getAttribute('onclick').match(/'([^']+)'/)[1],first); }
  document.getElementById('orgFilterBar').style.display  = group==='organic' ? 'flex' : 'none';
  document.getElementById('snowFilterBar').style.display = group==='snow'    ? 'flex' : 'none';
  if(group==='snow' && !SNOW_LOADED){ fetchSnowData(); }
}
function showTab(id,btn){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  if(btn) btn.classList.add('active');
}

// ═══ FILTERS — AJAX ══════════════════════════════════════
let _debTimer;
function debouncedFilter(){ clearTimeout(_debTimer); _debTimer=setTimeout(fetchFiltered,600); }
function applyFilters(){ fetchFiltered(); }
function clearFilters(){
  ['fSegment','fKam','fSfStatus','fTracker','fAssignee','fOrgStatus','fAccount','fOppType'].forEach(id=>{
    document.querySelectorAll('#'+id+' input[type=checkbox]').forEach(c=>c.checked=false);
    msUpdateBtn(id);
  });
  ['fOrderNum','fReqNum','fAcctNum'].forEach(id=>document.getElementById(id).value='');
  ['fDateFrom','fDateTo'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('fActiveWip').checked=false;
  document.getElementById('fOverdue').checked=false;
  fetchFiltered();
}

const getMulti = id => Array.from(document.querySelectorAll('#'+id+' input[type=checkbox]:checked')).map(c=>c.value);

async function fetchFiltered(){
  const params = new URLSearchParams();
  getMulti('fSegment').forEach(v=>params.append('segment[]',v));
  getMulti('fKam').forEach(v=>params.append('kam[]',v));
  getMulti('fSfStatus').forEach(v=>params.append('sf_status[]',v));
  getMulti('fTracker').forEach(v=>params.append('tracker[]',v));
  getMulti('fAssignee').forEach(v=>params.append('assignee[]',v));
  getMulti('fOrgStatus').forEach(v=>params.append('org_status[]',v));
  getMulti('fAccount').forEach(v=>params.append('account[]',v));
  getMulti('fOppType').forEach(v=>params.append('opp_type[]',v));
  params.set('order_number',   document.getElementById('fOrderNum').value);
  params.set('request_number', document.getElementById('fReqNum').value);
  params.set('acct_number',    document.getElementById('fAcctNum').value);
  params.set('date_from',      document.getElementById('fDateFrom').value);
  params.set('date_to',        document.getElementById('fDateTo').value);
  params.set('active_wip',     document.getElementById('fActiveWip').checked ? 'true' : '');
  params.set('overdue_only',   document.getElementById('fOverdue').checked ? 'true' : '');
  const wipSel = document.getElementById('wipMonth');
  if(wipSel && wipSel.value){ const [wy,wm]=wipSel.value.split('-'); params.set('wip_year',wy); params.set('wip_month',wm); }
  const hint = document.getElementById('filterHint');
  hint.textContent = 'Filtering…';
  document.getElementById('filterSpinner').style.display = 'inline-block';
  try {
    const res  = await fetch(`/snow_organic_dashboard/filter?${params}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    });
    if(!res.ok) throw new Error('Filter request failed');
    const data = await res.json();
    SF = data.sf; ORGANIC = data.organic; BRIDGE = data.bridge;
    renderAll();
    const anyActive = ['segment[]','kam[]','sf_status[]','tracker[]','assignee[]','org_status[]','account[]','opp_type[]']
      .some(k=>params.getAll(k).length>0);
    hint.textContent = anyActive
      ? `Filtered · ${n2s(SF.kpi.total)} SF subs · ${n2s(ORGANIC.kpi.total)} in delivery · Live ${data.generated_at}`
      : `FY27 · ${n2s(SF.kpi.total)} SF subscriptions · ${n2s(ORGANIC.kpi.total)} in delivery · Live ${data.generated_at}`;
  } catch(e) {
    hint.textContent = 'Filter error — please retry';
    console.error(e);
  } finally {
    document.getElementById('filterSpinner').style.display = 'none';
  }
}

function renderAll(){
  populateKpis();
  buildBridgeFunnel();
  buildNlMonthlyTable();
  buildSfAcctTable(SF.top_accounts);
  buildKamTable(SF.kams);
  buildGapTable(SF.gap);
  buildOrgPipelineTable(ORGANIC.all_orders);
  buildWipTable();
  buildAcctBars('sfAcctBars', SF.top_accounts, 'n', 'mrr');
  buildAcctBars('orgAcctBars',    ORGANIC.top_accounts, 'a', 'mrr');
  buildAcctBars('orgRevAcctBars', ORGANIC.top_accounts, 'a', 'mrr');
  updateAllCharts();
}

function updateAllCharts(){
  // SF Monthly trend
  ch('cSfMonthly', c => {
    c.data.labels = SF.monthly.map(m=>m.m);
    c.data.datasets[0].data = SF.monthly.map(m=>m.subs);
    c.data.datasets[1].data = SF.monthly.map(m=>m.mrr);
  });
  // SF Status funnel
  ch('cSfStatus', c => {
    c.data.labels = SF.statuses.map(s=>s.s.replace('Service Delivery is not required','Not Required').replace('Service Delivery','SD'));
    c.data.datasets[0].data = SF.statuses.map(s=>s.cnt);
  });
  // SF MRR by status
  const sfMrrData = SF.statuses.filter(s=>s.mrr>0);
  ch('cSfMrrByStatus', c => {
    c.data.labels = sfMrrData.map(s=>s.s.substring(0,22)+'…');
    c.data.datasets[0].data = sfMrrData.map(s=>s.mrr);
  });
  // SF Opp type donut
  ch('cSfOppType', c => {
    c.data.labels = SF.opp_types.map(o=>o.t);
    c.data.datasets[0].data = SF.opp_types.map(o=>o.cnt);
  });
  // SF Accounts donut
  ch('cSfAcctMrr', c => {
    const top8 = SF.top_accounts.slice(0,8);
    c.data.labels = top8.map(a=>a.n.substring(0,18));
    c.data.datasets[0].data = top8.map(a=>a.mrr);
  });
  // KAM MRR
  ch('cKamMrr', c => {
    const top10 = SF.kams.slice(0,10);
    c.data.labels = top10.map(k=>k.k.split(' ')[0]);
    c.data.datasets[0].data = top10.map(k=>k.mrr);
  });
  // KAM delivery stacked
  ch('cKamDelivery', c => {
    const top8 = SF.kams.slice(0,8);
    c.data.labels = top8.map(k=>k.k.split(' ')[0]);
    c.data.datasets[0].data = top8.map(k=>k.organic);
    c.data.datasets[1].data = top8.map(k=>Math.max(0,k.accepted-k.organic));
    c.data.datasets[2].data = top8.map(k=>k.in_qual);
  });
  // New Logo monthly
  ch('cNlAccts', c => {
    c.data.labels = SF.monthly.map(m=>m.m);
    c.data.datasets[0].data = SF.monthly.map(m=>m.accounts);
    c.data.datasets[1].data = SF.monthly.map(m=>m.nl_accts);
    c.data.datasets[2].data = SF.monthly.map(m=>m.nl_mrr);
  });
  ch('cNlMrr', c => {
    c.data.labels = SF.monthly.map(m=>m.m);
    c.data.datasets[0].data = SF.monthly.map(m=>m.nl_mrr);
    c.data.datasets[1].data = SF.monthly.map(m=>m.mrr-m.nl_mrr);
  });
  // Bridge monthly
  ch('cBridgeMonthly', c => {
    c.data.labels = BRIDGE.monthly.map(m=>m.m);
    c.data.datasets[0].data = BRIDGE.monthly.map(m=>m.subs);
    c.data.datasets[1].data = BRIDGE.monthly.map(m=>m.organic);
  });
  // Gap by KAM
  ch('cGapByKam', c => {
    c.data.labels = BRIDGE.gap_by_kam.map(k=>k.kam.split(' ')[0]);
    c.data.datasets[0].data = BRIDGE.gap_by_kam.map(k=>k.gap_mrr);
  });
  // Bridge opp type
  ch('cBridgeOppType', c => {
    c.data.labels = SF.opp_types.map(o=>o.t);
    c.data.datasets[0].data = SF.opp_types.map(o=>o.cnt);
  });
  // Organic monthly
  ch('cOrgMonthly', c => {
    c.data.labels = ORGANIC.monthly.map(m=>m.m);
    c.data.datasets[0].data = ORGANIC.monthly.map(m=>m.cnt);
  });
  // Organic opp type donut
  ch('cOrgOppType', c => {
    c.data.labels = ORGANIC.opp_types.map(o=>o.t);
    c.data.datasets[0].data = ORGANIC.opp_types.map(o=>o.n);
  });
  // Organic assignee
  ch('cOrgAssignee', c => {
    c.data.labels = ORGANIC.assignees.map(a=>a.a);
    c.data.datasets[0].data = ORGANIC.assignees.map(a=>a.n);
  });
  // Organic SLA donut
  ch('cOrgSla', c => {
    const breach = ORGANIC.kpi.sla_total - ORGANIC.kpi.sla_ok;
    c.data.datasets[0].data = [breach, ORGANIC.kpi.sla_ok];
  });
  // Organic status
  ch('cOrgStatus', c => {
    c.data.labels = ORGANIC.statuses.map(s=>s.s);
    c.data.datasets[0].data = ORGANIC.statuses.map(s=>s.n);
  });
  // Organic MRR by opp type
  ch('cOrgMrrOpp', c => {
    const m={};
    ORGANIC.all_orders.forEach(o=>{const k=o.opp||'Unknown';m[k]=(m[k]||0)+(o.mrr||0);});
    const s=Object.entries(m).sort((a,b)=>b[1]-a[1]);
    c.data.labels=s.map(x=>x[0]);
    c.data.datasets[0].data=s.map(x=>x[1]);
  });
  // SLA hours
  ch('cSlaHours', c => {
    c.data.labels = ORGANIC.sla_avg.map(s=>s.s);
    c.data.datasets[0].data = ORGANIC.sla_avg.map(s=>s.h);
    c.data.datasets[0].backgroundColor = ORGANIC.sla_avg.map(s=>s.h>48?'#dc2626':'#d97706');
  });
  // SLA breach stacked
  ch('cSlaBreach', c => {
    c.data.labels = ORGANIC.sla_avg.map(s=>s.s);
    c.data.datasets[0].data = ORGANIC.sla_avg.map(s=>s.breached||0);
    c.data.datasets[1].data = ORGANIC.sla_avg.map(s=>s.on_time||0);
  });
}
function ch(id, fn){ if(CHARTS[id]){ fn(CHARTS[id]); CHARTS[id].update('none'); } }

// ═══ KPI POPULATION ══════════════════════════════════════
function populateKpis(){
  const s=SF.kpi, o=ORGANIC.kpi, b=BRIDGE;
  // SF overview
  document.getElementById('kSfTotal').textContent    = n2s(s.total);
  document.getElementById('kSfSub').textContent      = n2s(s.accounts)+' accounts · '+SF.monthly.length+' months';
  document.getElementById('kSfMrr').textContent      = fmtK(s.mrr_zmw);
  document.getElementById('kSfNrr').textContent      = fmtK(s.nrr_zmw);
  document.getElementById('kNlAccts').textContent    = n2s(s.new_logo_accounts);
  document.getElementById('kNlSub').textContent      = n2s(s.new_logo_orders)+' orders · New Business only';
  document.getElementById('kNlMrr').textContent      = fmtK(s.new_logo_mrr);
  const nlPct = s.mrr_zmw>0?Math.round(s.new_logo_mrr/s.mrr_zmw*100):0;
  document.getElementById('kNlPct').textContent      = nlPct+'% of total pipeline';
  document.getElementById('kAccepted').textContent   = n2s(s.accepted);
  document.getElementById('kAcceptedMrr').textContent= 'MRR ZMW '+fmtK(s.accepted_mrr);
  document.getElementById('kInQual').textContent     = n2s(s.in_qual);
  document.getElementById('kInQualMrr').textContent  = 'MRR ZMW '+fmtK(s.qual_mrr);
  document.getElementById('kDelivered').textContent  = n2s(s.delivered);
  document.getElementById('kDeliveredMrr').textContent= 'MRR ZMW '+fmtK(s.delivered_mrr);
  document.getElementById('kRejected').textContent   = n2s(s.rejected);
  document.getElementById('kRejectedMrr').textContent= 'MRR ZMW '+fmtK(s.rejected_mrr);
  document.getElementById('kNotReq').textContent     = n2s(s.not_required);
  // KAM leaderboard
  document.getElementById('kKamCount').textContent   = n2s(SF.kams.length);
  if(SF.kams.length){
    const topMrr=SF.kams[0], topDel=[...SF.kams].sort((a,b)=>b.pct-a.pct)[0];
    const topOrd=[...SF.kams].sort((a,b)=>b.orders-a.orders)[0];
    const avgDel=SF.kams.reduce((s,k)=>s+k.pct,0)/SF.kams.length;
    document.getElementById('kTopKam').textContent       = topMrr.k.split(' ')[0]+' '+topMrr.k.split(' ')[1];
    document.getElementById('kTopKamMrr').textContent    = 'ZMW '+fmtK(topMrr.mrr);
    document.getElementById('kTopDelivery').textContent  = topDel.k.split(' ')[0];
    document.getElementById('kTopDeliveryPct').textContent= topDel.pct.toFixed(1)+'% delivered';
    document.getElementById('kMostOrders').textContent   = topOrd.k.split(' ')[0];
    document.getElementById('kMostOrdersCnt').textContent= n2s(topOrd.orders)+' subscriptions';
    document.getElementById('kAvgDelivery').textContent  = avgDel.toFixed(1)+'%';
  }
  // New logos page 2
  document.getElementById('nl2Accts').textContent    = n2s(s.new_logo_accounts);
  document.getElementById('nl2Orders').textContent   = n2s(s.new_logo_orders);
  document.getElementById('nl2Mrr').textContent      = fmtK(s.new_logo_mrr);
  document.getElementById('nl2Pct').textContent      = 'ZMW · '+nlPct+'% of pipeline';
  document.getElementById('nl2OtherMrr').textContent = fmtK(s.mrr_zmw - s.new_logo_mrr);
  document.getElementById('nl2Delivered').textContent= n2s(s.delivered);
  // Bridge alert
  const gapCount=b.funnel[2]?b.funnel[2].val - (b.funnel[3]?b.funnel[3].val:0):0;
  document.getElementById('bridgeAlertTitle').textContent =
    n2s(gapCount)+' orders accepted for delivery but NOT yet in Organic — ZMW '+fmtK(b.gap_mrr)+' MRR at risk';
  document.getElementById('gapAlertTitle').textContent =
    n2s(SF.gap.length)+' gap orders shown — ZMW '+fmtK(b.gap_mrr)+' accepted MRR without Organic issue';
  // Gap KPIs
  document.getElementById('kGapAccepted').textContent = n2s(gapCount);
  document.getElementById('kGapMrr').textContent      = fmtK(b.gap_mrr);
  document.getElementById('kGapInOrganic').textContent= n2s(b.funnel[3]?b.funnel[3].val:0);
  if(SF.gap.length){
    const sorted=[...SF.gap].sort((a,b2)=>b2.days-a.days);
    document.getElementById('kGapOldest').textContent    = sorted[0].days+'d';
    document.getElementById('kGapOldestAcct').textContent= sorted[0].a.substring(0,20);
    const avg=Math.round(SF.gap.reduce((s,g)=>s+g.days,0)/SF.gap.length);
    document.getElementById('kGapAvg').textContent       = avg+'d';
  }
  // Organic summary
  document.getElementById('kOrgTotal').textContent   = n2s(o.total);
  document.getElementById('kOrgWip').textContent     = n2s(o.wip);
  document.getElementById('kOrgOverdue').textContent = n2s(o.overdue);
  document.getElementById('kSlaBreach').textContent  = o.sla_breach+'%';
  document.getElementById('kSlaBreachSub').textContent= n2s(o.sla_total-o.sla_ok)+' of '+n2s(o.sla_total)+' records';
  document.getElementById('kOrgMrr').textContent     = fmtK(o.mrr)+(o.mrr_usd?fmtUK(o.mrr_usd):'');
  document.getElementById('kOrgNrr').textContent     = fmtK(o.nrr)+(o.nrr_usd?fmtUK(o.nrr_usd):'');
  document.getElementById('kOrgComm').textContent    = n2s(o.commercial);
  document.getElementById('kOrgC2').textContent      = n2s(o.c2);
  // Revenue page
  const covPct = s.mrr_zmw>0 ? (o.mrr/s.mrr_zmw*100).toFixed(1) : '0.0';
  document.getElementById('kCovPct').textContent  = covPct+'%';
  document.getElementById('kCovSub').textContent  = 'ZMW '+fmtK(o.mrr)+(o.mrr_usd?' · USD '+fmtK(o.mrr_usd):'')+' of ZMW '+fmtK(s.mrr_zmw)+' SF pipeline';
  document.getElementById('kRevNrr').textContent  = 'ZMW '+fmtK(o.nrr)+(o.nrr_usd?' · USD '+fmtK(o.nrr_usd):'');
  document.getElementById('kRevNrrSub').textContent= 'Across '+n2s(o.total)+' active delivery orders';
