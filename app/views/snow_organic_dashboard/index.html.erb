let _dtSort = {col: 'date', dir: 'asc'};
let _dtRows = [];
function orgIssueTable(rows, skipSort){
  _dtRows = rows;
  if(!skipSort) _dtSort = {col: 'date', dir: 'asc'};
  return _orgIssueTableHtml();
}
function _orgIssueTableHtml(){
  const rows = [..._dtRows].sort((a,b)=>{
    const col = _dtSort.col;
    let av = col==='date' ? (a.date||'') : col==='mrr' ? (a.mrr||a.mrr_zmw||0) : col==='age' ? (a.age||0) : '';
    let bv = col==='date' ? (b.date||'') : col==='mrr' ? (b.mrr||b.mrr_zmw||0) : col==='age' ? (b.age||0) : '';
    if(av<bv) return _dtSort.dir==='asc'?-1:1;
    if(av>bv) return _dtSort.dir==='asc'?1:-1;
    return 0;
  });
  const arrow = d => _dtSort.col===d ? (_dtSort.dir==='asc'?' ▲':' ▼') : '';
  const th = (col,lbl) => `<th style="cursor:pointer;user-select:none" onclick="dtSortBy('${col}')">${lbl}${arrow(col)}</th>`;
  return `<div class="tbl"><table><thead><tr>
    <th>#</th><th>Account</th><th>Order</th><th>Tracker</th><th>Status</th>
    ${th('date','Date')}${th('mrr','MRR')}${th('age','Age')}
    <th>Assignee</th></tr></thead>
    <tbody>${rows.map(o=>`<tr onclick="window.open('/issues/${o.id||o.issue_id}','_blank')">
      <td><strong>#${o.id||o.issue_id}</strong></td>
      <td>${((o.account||o.a||'—')+'').substring(0,22)}</td>
      <td><code>${o.order||o.order_number||'—'}</code></td>
      <td>${o.tracker||o.tracker_name||'—'}</td>
      <td><span class="badge bb">${(o.status||o.status_name||'—').substring(0,22)}</span></td>
      <td>${o.date||'—'}</td>
      <td>${fmt(o.mrr||o.mrr_zmw)}</td>
      <td>${o.age||o.age_days||0}d</td>
      <td>${o.assignee||o.assignee_name||'—'}</td>
    </tr>`).join('')}</tbody></table></div>`;
}
function dtSortBy(col){
  if(_dtSort.col===col){ _dtSort.dir = _dtSort.dir==='asc'?'desc':'asc'; }
  else { _dtSort = {col, dir: col==='date'||col==='age' ? 'asc' : 'desc'}; }
  document.getElementById('dtBody').querySelector('.tbl').outerHTML = _orgIssueTableHtml();
}
